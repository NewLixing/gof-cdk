# API base URL for the Cloudflare Workers backend
# For development, use local worker URL
VITE_API_BASE_URL=http://localhost:8787

# For production, use your deployed worker URL
# VITE_API_BASE_URL=https://your-worker.your-subdomain.workers.dev

# Enable manager page (set to "true" to show /manager route)
VITE_ENABLE_MANAGER_PAGE=true
